# larry test container image
# Minimal Gentoo-like environment for ebuild testing
#
# Build: podman build -t larry-test -f Containerfile.larry-test .
# Usage: podman run --rm -v /path/to/overlay:/overlay larry-test emerge <pkg>

FROM docker.io/library/ubuntu:24.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && apt-get install -y \
    bash \
    coreutils \
    diffutils \
    findutils \
    grep \
    gzip \
    make \
    sed \
    tar \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Gentoo Portage dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-setuptools \
    python3-wheel \
    git \
    rsync \
    && rm -rf /var/lib/apt/lists/*

# Create larry user for non-root operation
RUN useradd -m -s /bin/bash larry

# Set Gentoo EPREFIX
ENV EPREFIX=/larry

# Create necessary directories
RUN mkdir -p /overlay /distfiles /binpkgs /var/cache/distfiles /var/cache/binpkgs /larry

# Set environment
ENV DISTDIR=/distfiles
ENV PKGDIR=/binpkgs

# Default command
CMD ["emerge", "--help"]
